# Copia este archivo como .env y completa los valores. No subas .env ni la llave.

# Wallet address del cliente de Open Payments (la que tiene la llave en el test wallet)
APP_WALLET_ADDRESS=https://ilp.interledger-test.dev/tu-app
# Key ID que muestra el test wallet al generar la llave
KEY_ID=pega-aqui-el-key-id
# Ruta a la llave privada, relativa a /servidor (o absoluta)
PRIVATE_KEY_PATH=../private.key

# Comercio de prueba: lo usa `npm run probar` y se crea como primera cuenta
TIENDA_WALLET_ADDRESS=https://ilp.interledger-test.dev/tu-comercio
TIENDA_NOMBRE=Mi Tienda
# Wallet que paga en `npm run probar` (no se mueve dinero)
CLIENTA_WALLET_ADDRESS=https://ilp.interledger-test.dev/tu-cliente

PORT=3000
